config BOARD_DECTCOMM
	select SOC_NRF9151_LACA if BOARD_DECTCOMM_NRF9151 || BOARD_DECTCOMM_NRF9151_NS
	select SOC_NRF5340_CPUNET_QKAA if BOARD_DECTCOMM_NRF5340_CPUNET
	select SOC_NRF5340_CPUAPP_QKAA if BOARD_DECTCOMM_NRF5340_CPUAPP || BOARD_DECTCOMM_NRF5340_CPUAPP_NS
